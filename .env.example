# ============================================
# JARVIS ECC - CONFIGURACIÓN DE ENTORNO
# ============================================
# COPIA ESTE ARCHIVO COMO .env Y RELLENA TUS CLAVES
# NUNCA SUBAS EL .env REAL AL REPOSITORIO

# --- NVIDIA Build (Nemotron 3 Ultra) ---
# Obtén tu API key en: https://build.nvidia.com/
NVIDIA_API_KEY=tu_nvidia_api_key_aqui
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- OpenRouter (Respaldo automático) ---
# Obtén tu API key en: https://openrouter.ai/
OPENROUTER_API_KEY=tu_openrouter_api_key_aqui
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_FALLBACK_MODELS=openrouter/auto,openrouter/claude-3.5-sonnet,openrouter/gpt-4o

# --- Configuración del Servidor ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Configuración de Modelos ---
DEFAULT_MODEL=nvidia/nemotron-3-ultra
MAX_TOKENS=8192
TEMPERATURE=0.3
TOP_P=0.9
STREAM=true

# --- Timeouts (segundos) ---
REQUEST_TIMEOUT=120
WS_HEARTBEAT_INTERVAL=30
WS_RECONNECT_MAX_ATTEMPTS=5

# --- Configuración de Seguridad ---
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# --- APIs Externas (Opcional - para herramientas OSINT) ---
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# HUNTER_API_KEY=
# CLEARBIT_API_KEY=

# --- Base de Datos (Opcional - para persistencia) ---
# DATABASE_URL=sqlite+aiosqlite:///./jarvis.db
# REDIS_URL=redis://localhost:6379/0